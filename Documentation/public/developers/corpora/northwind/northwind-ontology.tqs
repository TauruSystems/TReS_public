  - unhandled blank-node shape (no owl:unionOf) on predicate ':equivalentClass': a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty :hasProduct ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Product ] [ a owl:Restriction ; owl:onProperty :quantity ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] )
